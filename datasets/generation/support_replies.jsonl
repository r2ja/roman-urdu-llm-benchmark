{"id": "sup-00a", "prompt": "Aik banking assistant ka opening greeting likho jo customer ko salaam kare, apna taaruf de, aur poochay ke kaise madad kar sakta hai.", "reference": "Assalam-o-Alaikum, mera naam Jabbar hai. Mein aap ka banking assistant hoon. Aap ki mein kya madad kar sakta hoon?", "register": "professional banking assistant, warm greeting", "system": "Sirf Pakistani Roman Urdu mein professional banking-assistant reply do. Hindi ya kitabi Urdu use mat karo. English loanwords (account, balance) theek hain.", "tags": ["banking", "greeting"]}
{"id": "sup-00b", "prompt": "Customer ki complaint darj karne ke baad usay batao ke complaint mil gayi hai aur 2-3 din mein team ka numainda raabta karega.", "reference": "Aap ki complaint wasool ho chuki hai. 2 se 3 din mein hamari team se aik numainda aap se raabta karega. Aap ke sabar ka shukria.", "register": "professional banking assistant, reassuring", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["banking", "complaint"]}
{"id": "sup-01", "prompt": "Customer ki shikayat: 'ATM se paisay kat gaye lekin cash nahi nikla.' Reply likho jo shikayat acknowledge kare, tasalli de, aur 48 ghantay mein raqam wapsi ka yaqeen dilaye.", "reference": "Aap ki pareshani bilkul jaiz hai aur is ke liye maazrat. Aap ki complaint register kar li gayi hai. Umeed hai agle 48 ghantay mein kati hui amount aap ke account mein wapas aa jayegi. Kisi bhi madad ke liye hum yahan mojood hain.", "register": "professional customer support, warm and reassuring", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["banking", "complaint"]}
{"id": "sup-02", "prompt": "Customer: 'Do din se internet down hai.' Reply likho jo maazrat kare, bataye team kaam kar rahi hai, aur shaam tak bahaali ki umeed de.", "reference": "Is takleef ke liye maazrat. Aap ke area mein internet restore karne par hamari technical team abhi kaam kar rahi hai, aur umeed hai aaj shaam tak service normal ho jayegi. Aap ke sabar ka shukria.", "register": "professional customer support, apologetic", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["telecom", "outage"]}
{"id": "sup-03", "prompt": "Customer: 'Mera order 5 din late hai.' Reply likho jo maazrat kare aur tracking link dene ki peshkash kare.", "reference": "Aap ke order mein delay ke liye maazrat. Main abhi aap ke order ki current position check kar ke aap ko tracking link bhej deta hun, taake aap khud bhi status dekh sakein. Sabar ka shukria.", "register": "professional customer support, apologetic", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["ecommerce", "delay"]}
{"id": "sup-04", "prompt": "Customer refund maang raha hai lekin policy ke mutabiq 14 din guzar chukay hain. Politely mana karo aur alternative offer karo.", "reference": "Aap ki baat samajh sakta hun, lekin humari policy ke mutabiq refund sirf 14 din ke andar possible hai jo ab guzar chuke hain. Iske badle hum aap ko store credit ya exchange offer kar sakte hain. Kya ye option aap ke liye theek rahega?", "register": "professional customer support, empathetic but firm", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["policy", "refusal"]}
{"id": "sup-05", "prompt": "Customer: 'Driver ne bad-tameezi ki.' Reply likho jo sanjeedgi se sunay, maazrat kare, aur action ka yaqeen dilaye.", "reference": "Aap ke saath jo hua us ke liye hum sharminda hain, ye humare standard ke bilkul khilaaf hai. Aap ki complaint serious tor par le li gayi hai aur mutalliqa driver ke against zaroori action liya jayega. Aap ka feedback humare liye bohat important hai.", "register": "professional customer support, serious and apologetic", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["ride-hailing", "complaint"]}
{"id": "sup-06", "prompt": "Customer ko batao ke uski appointment kal subah 11 baje confirm ho gayi hai aur 10 minute pehle aane ki guzarish karo.", "reference": "Aap ki appointment kal subah 11 baje confirm ho chuki hai. Meharbani kar ke 10 minute pehle aa jayein taake process asaani se complete ho sake. Aap ke aane ka intzar rahega.", "register": "professional, polite confirmation", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["appointment", "confirmation"]}
{"id": "sup-07", "prompt": "Customer: 'Password reset nahi ho raha.' Reply likho jo simple steps mein rehnumai kare.", "reference": "Koi masla nahi, main guide karta hun. Login page par 'Forgot Password' par click karein, phir apna registered number ya email daalein. Aap ko ek code milega jise enter kar ke naya password set kar lein. Phir bhi issue ho to zaroor bataiyega.", "register": "professional customer support, helpful step-by-step", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["technical", "howto"]}
{"id": "sup-08", "prompt": "Customer ne khush ho kar tareef ki. Ek warm shukria reply likho.", "reference": "Aap ke ye words sun kar bohat khushi hui, bohat shukria! Aap jaise customers hi humari asal taqat hain. Aainda bhi best service dene ki poori koshish karenge.", "register": "warm, appreciative", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["positive", "thanks"]}
{"id": "sup-09", "prompt": "Customer ghussay mein hai aur agent se baat karna chahta hai. Reply likho jo tasalli de aur agent se connect karne ka yaqeen dilaye.", "reference": "Main aap ki pareshani samajh sakta hun aur is ke liye maazrat. Fikar na karein, main abhi aap ko humare ek support agent se connect kar raha hun jo aap ki poori help karenge. Baraye meharbani thodi dair intzar karein.", "register": "professional, calming, de-escalating", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["escalation", "human_agent"]}
{"id": "sup-10", "prompt": "Customer ko batao ke uske account par ghair-mamooli login ki koshish hui hai aur usay password badalne ki hidayat karo.", "reference": "Aap ke account ki security ke liye ittila di ja rahi hai ke us par ek unusual login attempt hua hai. Baraye meharbani foran apna password change kar lein aur two-factor authentication on kar lein. Kisi madad ki zaroorat ho to hum mojood hain.", "register": "professional, security-conscious", "system": "Reply only in professional Pakistani Roman Urdu; English loanwords are fine.", "tags": ["security", "alert"]}
